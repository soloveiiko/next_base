{
  "name": "next-base",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "next build",
    "build:production": "dotenv -e .env.production -- next build",
    "build:staging": "dotenv -e .env.staging -- next build",
    "check": "prettier --check .",
    "format": "prettier --write .",
    "lint": "next lint",
    "prepare": "husky",
    "start:dev": "dotenv -e .env.development -- next dev",
    "start:production": "dotenv -e .env.production -- next start",
    "start:staging": "dotenv -e .env.staging -- next start",
    "svg-imports": "node src/lib/utils/generateSvgImports.cjs public/svg public/svg/index.js",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "eslintConfig": {
    "extends": [
      "next",
      "plugin:tailwindcss/recommended",
      "plugin:prettier/recommended"
    ]
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.7.0",
    "dotenv": "^16.4.5",
    "dotenv-cli": "^7.4.2",
    "next": "15.2.4",
    "next-intl": "^3.15.0",
    "prop-types": "^15.8.1",
    "react": "^18",
    "react-dom": "^18",
    "react-redux": "^9.2.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.2.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.23.0",
    "eslint-config-next": "^15.2.4",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-tailwindcss": "^3.18.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^15.5.0",
    "postcss": "^8.4.38",
    "prettier": "^3.5.3",
    "prettier-plugin-packagejson": "^2.5.0",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tailwindcss": "^3.4.4"
  }
}
